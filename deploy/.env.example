# Mitori クラスタデプロイ用の環境変数テンプレート
#
# このファイルを .env にコピーして実値を埋めること:
#   cp .env.example .env
#
# .env は .gitignore で除外済み（リポジトリにコミットされない）。
# 実値の管理方針は ../SECURITY.md を参照。
#
# deploy_cluster.py がこの .env を読み込んで Secret を作成する。
# DB ユーザー/DB 名の対応は稼働中クラスタの実態に準拠（deploy-design.md 第5章）。

# --- MariaDB Helm 認証（mariadb-auth） ---
# root と、Helm が作成する appuser 用パスワード
MARIADB_ROOT_PASSWORD=
MARIADB_HELM_APPUSER_PASSWORD=

# --- DB 接続ユーザーごとのパスワード ---
# inv_app: cve-watch / epss / inventory-scan が共用（DB: inventory_scan）
DB_INV_APP_PASSWORD=
# eol_app: eol-watch 用（DB: eol_watch）
DB_EOL_APP_PASSWORD=
# mitre_app: mitre-collector / mitre-normalizer 用（DB: mitre_attack）
DB_MITRE_APP_PASSWORD=

# --- Slack Webhook URL（各サービス共通で使い回してよい） ---
EOL_WATCH_SLACK_WEBHOOK=
MITRE_ATTACK_SLACK_WEBHOOK=
MIRROR_CHECK_SLACK_WEBHOOK=
INVENTORY_SCAN_SLACK_WEBHOOK=
CVE_WATCH_SLACK_WEBHOOK=
EPSS_SLACK_WEBHOOK=

# --- GHCR（ghcr.io イメージ Pull 用） ---
GHCR_USERNAME=
GHCR_PAT=
GHCR_EMAIL=
